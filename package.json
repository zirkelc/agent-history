{
  "name": "agent-history",
  "version": "0.3.2",
  "private": true,
  "description": "Claude Code mod that exports your sessions to a folder and syncs them with git",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "validate": "claude plugin validate claude-code",
    "test": "claude plugin test claude-code",
    "check": "pnpm validate && pnpm test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "devDependencies": {
    "simple-git-hooks": "2.14.0"
  }
}
